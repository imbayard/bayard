{
  "name": "@benchpoints/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compute/roster-needs": {
      "types": "./dist/compute/roster-needs.d.ts",
      "import": "./dist/compute/roster-needs.js"
    },
    "./compute/results": {
      "types": "./dist/compute/results.d.ts",
      "import": "./dist/compute/results.js"
    },
    "./compute/flags/severity": {
      "types": "./dist/compute/flags/severity.d.ts",
      "import": "./dist/compute/flags/severity.js"
    },
    "./compute/trends/usage-trend": {
      "types": "./dist/compute/trends/usage-trend.d.ts",
      "import": "./dist/compute/trends/usage-trend.js"
    },
    "./team-codes": {
      "types": "./dist/adapters/nflverse/team-codes.d.ts",
      "import": "./dist/adapters/nflverse/team-codes.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "tsc -p tsconfig.json && node dist/scripts/sleeper-smoke.js",
    "espn-smoke": "tsc -p tsconfig.json && node dist/scripts/espn-smoke.js",
    "nflverse-smoke": "tsc -p tsconfig.json && node dist/scripts/nflverse-smoke.js"
  },
  "dependencies": {
    "lru-cache": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
